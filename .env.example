# Twelve Data free API key (https://twelvedata.com) -- supports NSE via :NSE suffix
TWELVEDATA_API_KEY=your_twelvedata_key_here

# Telegram bot (via @BotFather) and your chat id
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Regime filter mode: strict | permissive | adaptive (default: strict)
REGIME_MODE=strict
